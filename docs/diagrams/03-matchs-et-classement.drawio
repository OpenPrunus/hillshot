<mxfile host="app.diagrams.net"><diagram name="Matchs et classement" id="d1"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" page="1" pageScale="1" pageWidth="1600" pageHeight="1200"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="n0" value='&lt;div style="text-align:center"&gt;&lt;b&gt;MatchService&lt;/b&gt;&lt;/div&gt;&lt;hr size="1"&gt;+start(Client, Client): Room&lt;br&gt;+fire(Client, Shot)&lt;br&gt;+tick(now): void&lt;br&gt;+leave(Client): void&lt;br&gt;+requestRematch(Client)' style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;fontSize=11;fillColor=#ffffff;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="40" y="40" width="300" height="115" as="geometry"/></mxCell><mxCell id="n1" value='&lt;div style="text-align:center"&gt;&lt;b&gt;Room&lt;/b&gt;&lt;/div&gt;&lt;hr size="1"&gt;+ranked: bool&lt;br&gt;+phase: RoomPhase&lt;br&gt;+deadline, resumeAt: int&lt;br&gt;+lastShots: array&lt;br&gt;+idleTurns: array&lt;br&gt;+sideOf(Client): ?Side' style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;fontSize=11;fillColor=#ffffff;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="40" y="260" width="300" height="130" as="geometry"/></mxCell><mxCell id="n2" value='&lt;div style="text-align:center"&gt;&lt;i style="font-size:10px"&gt;«enumeration»&lt;/i&gt;&lt;br&gt;&lt;b&gt;RoomPhase&lt;/b&gt;&lt;/div&gt;&lt;hr size="1"&gt;Aiming&lt;br&gt;Flying&lt;br&gt;Over' style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;fontSize=11;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="40" y="500" width="170" height="99" as="geometry"/></mxCell><mxCell id="n3" value='&lt;div style="text-align:center"&gt;&lt;b&gt;Duel&lt;/b&gt;&lt;/div&gt;&lt;hr size="1"&gt;(Hillshot\Engine)&lt;br&gt;+fire(Shot): Outcome' style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop